{
  "version": 1,
  "robots": {
    "nao1": {
      "dm_url": "http://127.0.0.1:8080"
    }
  },
  "ppt": {
    "enabled": true,
    "file": "C:/NAOqi_fundamentals/NAO_Controller_WebAPI/py3_script_runner/assets/presentations/example_workshop_ppt.pptx",
    "fullscreen_required": false,
    "start_capture_on_run": true
  },
  "defaults": {
    "request_timeout_s": 45,
    "on_error": "prompt"
  },
  "steps": [
    {
      "id": "p1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "ppt",
        "mode": "next_build"
      }
    },
    {
      "id": "r1",
      "robot_id": "nao1",
      "start": {
        "mode": "with_prev"
      },
      "action": {
        "type": "say",
        "text": "Welkom bij de workshop."
      }
    },
    {
      "id": "eye1",
      "robot_id": "nao1",
      "start": {
        "mode": "after_prev",
        "delay_s": 0
      },
      "action": {
        "type": "do",
        "mode": "nao_set_eye_color",
        "color": "#00AEEF",
        "duration": 0.35
      }
    },
    {
      "id": "p2",
      "start": {
        "mode": "after_prev",
        "delay_s": 1
      },
      "action": {
        "type": "ppt",
        "mode": "goto",
        "slide": 3,
        "build": 1
      }
    }
  ]
}
