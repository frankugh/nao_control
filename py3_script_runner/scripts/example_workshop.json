{
  "version": 1,
  "robots": {
    "nao1": {
      "dm_url": "http://127.0.0.1:5301"
    },
    "nao2": {
      "dm_url": "http://127.0.0.1:5302"
    }
  },
  "defaults": {
    "request_timeout_s": 45,
    "on_error": "prompt"
  },
  "steps": [
    {
      "id": "s1",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "do",
        "mode": "command",
        "label": "STAND_UP"
      }
    },
    {
      "id": "s2",
      "robot_id": "nao2",
      "start": {
        "mode": "after_prev",
        "delay_s": 0
      },
      "action": {
        "type": "do",
        "mode": "command",
        "label": "STAND_UP"
      }
    },
    {
      "id": "s3",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "say",
        "text": "Hallo allemaal, ik ben Alex"
      }
    },
    {
      "id": "s4",
      "robot_id": "nao2",
      "start": {
        "mode": "after_prev",
        "delay_s": 2
      },
      "action": {
        "type": "say",
        "text": "En ik ben Rene"
      }
    },
    {
      "id": "s5",
      "start": {
        "mode": "after_prev",
        "delay_s": 0
      },
      "action": {
        "type": "pause",
        "seconds": 2
      }
    },
    {
      "id": "s6",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "do",
        "mode": "command",
        "label": "WAVE"
      }
    },
    {
      "id": "summary_capture_start",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "do",
        "mode": "summary_capture_start"
      }
    },
    {
      "id": "summary_capture_stop_and_draft",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "do",
        "mode": "summary_capture_stop_and_draft",
        "system_prompt_file": "master_prompts/workshop_summary_system.txt",
        "input_prompt_template": "Hieronder staat transcriptie van antwoorden op de vraag: 'Wat zou je vandaag willen leren over AI en/of robotica?'.\n\nTranscriptie:\n{transcript}\n\nExtra opdracht:\n{instruction}\n\nGeef nu de definitieve gesproken tekst die de robot hardop kan uitspreken.",
        "instruction": "Houd het kort, natuurlijk en spreekbaar. Geen bullets of kopjes. Benoem de belangrijkste leerwensen, noem kort eventuele zorgen, en eindig met een korte brugzin naar de volgende stap in de workshop."
      }
    },
    {
      "id": "summary_publish_or_cancel",
      "robot_id": "nao1",
      "start": {
        "mode": "manual"
      },
      "action": {
        "type": "do",
        "mode": "summary_publish"
      }
    },
    {
      "id": "s7",
      "robot_id": "nao1",
      "start": {
        "mode": "after_prev",
        "delay_s": 0
      },
      "action": {
        "type": "do",
        "mode": "command",
        "label": "REST"
      }
    },
    {
      "id": "s8",
      "robot_id": "nao2",
      "start": {
        "mode": "after_prev",
        "delay_s": 0
      },
      "action": {
        "type": "do",
        "mode": "command",
        "label": "REST"
      }
    }
  ]
}
