{
  "behavior_backend": "print",
  "debug_cmdrec": true,
  "confirm_method": "web",
  "confirm_policy": "when_guarded",
  "confirm_timeout_s": 10.0,
  "cmdrec": "latest",
  "cmdrec_bundles_dir": "dist",
  "nao_ip": "192.168.0.101",
  "nao_ip_enabled": true,
  "base_enabled": true,
  "base_autostart": true,
  "behavior_enabled": false,
  "behavior_timeout_s": 60.0,
  "custom_life_enabled": false,
  "custom_life_settings": {
    "basic_awareness": true,
    "background_movement": true,
    "breathing": true
  },
  "nao_auto_rest_after_s": 180,
  "nao_connection": {
    "primary": {
      "base_url": "http://127.0.0.1:5001/nao"
    },
    "fallback": {
      "base_url": "http://127.0.0.1:5000"
    },
    "health_ttl_s": 30.0,
    "health_checks": ["py3_ping", "py3_nao_ping"],
    "timeout_s": 45.0,
    "log_status": true
  },
  "input": {
    "type": "audio",
    "mic": {
      "type": "laptop",
      "params": {
        "sample_rate": 16000,
        "start_threshold_rms": 500,
        "stop_silence_ms": 1000,
        "pre_roll_ms": 500,
        "max_utterance_s": 12.0,
        "block_ms": 20,
        "input_device": null
      }
    },
    "stt": {
      "type": "vosk",
      "params": {
        "model_path": "../models/vosk-model-small-nl-0.22",
        "language": "nl",
        "sample_rate": 16000,
        "max_alternatives": 0,
        "enable_words": false,
        "grammar": null,
        "log_level": -1
      }
    },
    "params": {
      "confirm_before_record": true,
      "confirm_before_send": true,
      "start_timeout_s": null,
      "wake_mode": "timeout",
      "wake_timeout_s": 20,
      "wake_words": ["NAO", "Alex"],
      "print_input": true,
      "status_to_console": true
    }
  },
  "llm": {
    "type": "echo"
  },
  "output": {
    "type": "output_router",
    "params": {
      "target": "nao",
      "tts_engine": "piper",
      "timeout": 120.0
    }
  },
  "run": {
    "status_to_console": true
  }
}
