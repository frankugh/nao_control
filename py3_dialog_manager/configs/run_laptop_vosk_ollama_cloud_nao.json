{
  "behavior_backend": "print",
  "debug_cmdrec": true,
  "confirm_method": "web",
  "confirm_timeout_s": 10.0,
  "cmdrec": "v15",
  "cmdrec_bundles_dir": "dist",
  "nao_connection": {
    "primary": {
      "base_url": "http://127.0.0.1:5001/nao"
    },
    "fallback": {
      "base_url": "http://127.0.0.1:5000"
    },
    "health_ttl_s": 30.0,
    "health_checks": ["py3_ping", "py3_nao_ping"],
    "timeout_s": 45.0,
    "log_status": true
  },
  "run": {
    "status_to_console": true,
    "log_messages": true
  },
  "input": {
    "type": "audio",
    "mic": {
      "type": "laptop",
      "params": {
        "sample_rate": 16000,
        "start_threshold_rms": 500,
        "stop_silence_ms": 1000,
        "pre_roll_ms": 200,
        "max_utterance_s": 12.0,
        "block_ms": 20,
        "input_device": null
      }
    },
    "stt": {
      "type": "vosk",
      "params": {
        "model_path": "../models/vosk-model-small-nl-0.22",
        "language": "nl",
        "sample_rate": 16000,
        "max_alternatives": 0,
        "enable_words": false,
        "grammar": null,
        "log_level": -1
      }
    },
    "params": {
      "confirm_before_record": true,
      "confirm_before_send": true,
      "start_timeout_s": null,
      "print_input": true
    }
  },
  "llm": {
    "type": "ollama_cloud",
    "params": {
      "host": "https://ollama.com",
      "model": "gpt-oss:120b",
      "api_key": "${OLLAMA_API_KEY}",
      "system_prompt_file": "master_prompts/atlantis.txt",
      "context": {
        "max_history_turns": 6,
        "inject_runtime_context": true
      }
    }
  },
  "output": {
    "type": "nao_tts",
    "params": {
      "timeout": 45.0
    }
  }
}
