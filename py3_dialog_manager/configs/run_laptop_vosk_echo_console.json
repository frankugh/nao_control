{
  "behavior_backend": "print",
  "debug_cmdrec": true,
  "cmdrec": "latest",
  "cmdrec_bundles_dir": "dist",
  "confirm_method": "web",
  "confirm_timeout_s": 10.0,
  "input": {
    "type": "audio",
    "mic": {
      "type": "laptop",
      "params": {
        "sample_rate": 16000,
        "start_threshold_rms": 500,
        "stop_silence_ms": 1000,
        "pre_roll_ms": 200,
        "max_utterance_s": 12.0,
        "block_ms": 20,
        "input_device": null
      }
    },
    "stt": {
      "type": "vosk",
      "params": {
        "model_path": "../models/vosk-model-small-nl-0.22",
        "language": "nl",
        "sample_rate": 16000,
        "max_alternatives": 0,
        "enable_words": false,
        "grammar": null,
        "log_level": -1
      }
    },
    "params": {
      "confirm_before_record": true,
      "confirm_before_send": true,
      "start_timeout_s": null,
      "print_input": true,
      "status_to_console": true
    }
  },
  "llm": {
    "type": "echo"
  },
  "output": {
    "type": "console",
    "params": {
      "prefix": "BOT"
    }
  },
  "run": {
    "status_to_console": true
  }
}
